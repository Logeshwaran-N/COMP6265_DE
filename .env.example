# =============================
# Local / EC2 Docker frontend
# =============================
VITE_API_BASE_URL=http://localhost:8000

# =============================
# Backend auth mode
# local = JSON-file user store for local/EC2 testing
# cognito = AWS Cognito user pool login/admin-user flow
# =============================
REQUIRE_AUTH=true
AUTH_PROVIDER=local
LOCAL_AUTH_SECRET=change-this-local-secret
DEFAULT_ADMIN_EMAIL=admin@test.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# =============================
# Backend source config
# Use http://mock-api:8001 in Docker Compose.
# Use internal/disabled/fallback in App Runner single-service deployment.
# =============================
MOCK_API_BASE_URL=http://localhost:8001
DATA_ECONOMY_MOCK_API_BASE_URL=http://localhost:8001

# CORS: set this to your Amplify URL in AWS, for example:
# FRONTEND_ORIGINS=https://main.xxxxx.amplifyapp.com
FRONTEND_ORIGINS=*

# =============================
# Cognito settings, used when AUTH_PROVIDER=cognito
# =============================
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=YOUR_USER_POOL_ID
COGNITO_APP_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
COGNITO_ADMIN_GROUP=admin
# true = admin gives temporary password manually in the app
# false = Cognito sends an invitation email if email delivery is configured
COGNITO_SUPPRESS_INVITE=true
