# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend auth mode
# local = JSON-file user store for local/EC2 testing
# cognito = Cognito user pool login/admin-user flow for AWS
REQUIRE_AUTH=true
AUTH_PROVIDER=local
LOCAL_AUTH_SECRET=change-this-local-secret
DEFAULT_ADMIN_EMAIL=admin@test.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# Backend source config
MOCK_API_BASE_URL=http://localhost:8001

# Cognito settings, used only when AUTH_PROVIDER=cognito
COGNITO_REGION=YOUR_REGION
COGNITO_USER_POOL_ID=YOUR_USER_POOL_ID
COGNITO_APP_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
COGNITO_ADMIN_GROUP=admin
